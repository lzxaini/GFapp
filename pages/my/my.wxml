<view class="my_body">
  <!-- Apple-style 极简导航 -->
  <t-navbar t-class="navBar" left-arrow="{{false}}" fixed="{{false}}" title="个人中心" />

  <!-- Profile 头部 -->
  <view class="profile_section">
    <view class="profile_avatar_wrap">
      <image class="profile_avatar" src="{{userInfo.avatar ? ossUrl + userInfo.avatar : '../../static/icon/gf_logo_w.png'}}" bindtap="goLoginFlag" />
      <view class="profile_badge">{{userInfo.roles[0].roleName || '暂无角色'}}</view>
    </view>
    <view class="profile_name">{{userInfo.userName || '未登录'}}</view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu_section">
    <view class="menu_grid">
      <view class="menu_item" bindtap="goMyDept">
        <view class="menu_icon_wrap">
          <image class="menu_icon" src="../../static/icon/my_menu_1.png" />
        </view>
        <text class="menu_label">我的团队</text>
      </view>
      <view class="menu_item" bindtap="goRechargeHistory">
        <view class="menu_icon_wrap">
          <image class="menu_icon" src="../../static/icon/my_menu_2.png" />
        </view>
        <text class="menu_label">充值记录</text>
      </view>
      <view class="menu_item" bindtap="goServiceHistory">
        <view class="menu_icon_wrap">
          <image class="menu_icon" src="../../static/icon/my_menu_3.png" />
        </view>
        <text class="menu_label">服务记录</text>
      </view>
      <view class="menu_item" bindtap="goSystem">
        <view class="menu_icon_wrap">
          <image class="menu_icon" src="../../static/icon/my_menu_4.png" />
        </view>
        <text class="menu_label">设置</text>
      </view>
    </view>
  </view>

  <!-- 所属机构卡片 -->
  <view class="section_title">
    <text class="section_title_text">所属机构</text>
    <t-icon wx:if="{{userInfo.dept}}" name="qrcode" size="36rpx" color="#0066cc" bindtap="openQrCode" />
  </view>

  <view wx:if="{{userInfo.dept && userInfo.dept.deptName !== '游客部门'}}" class="dept_card">
    <view class="dept_card_row">
      <text class="dept_card_label">机构名称</text>
      <view class="dept_card_value_wrap">
        <text class="dept_card_value">{{userInfo.dept.deptName}}</text>
        <t-icon wx:if="{{userInfo.dept.deptName === '研发部门'}}" name="bug" color="#E6A23C" size="36rpx" bindtap="goDevPage" />
      </view>
    </view>
    <view class="dept_card_divider"></view>
    <view class="dept_card_row">
      <text class="dept_card_label">机构地址</text>
      <text class="dept_card_value dept_card_value--muted">{{userInfo.dept ? userInfo.dept.address || '-' : '-'}}-{{userInfo.dept ? userInfo.dept.addressDetail || '' : ''}}</text>
    </view>
    <view class="dept_card_divider"></view>
    <view class="dept_card_row">
      <text class="dept_card_label">开通时间</text>
      <text class="dept_card_value dept_card_value--muted">{{userInfo.dept.createTime || '--'}}</text>
    </view>
    <view wx:if="{{userInfo.dept.deptType != 4}}" class="dept_card_divider"></view>
    <view wx:if="{{userInfo.dept.deptType != 4}}" class="dept_card_row dept_card_row--action" bindtap="goDeptInfo">
      <text class="dept_card_label">团队管理</text>
      <view class="dept_card_action">
        <text class="dept_card_action_text">查看详情</text>
        <t-icon name="chevron-right" size="28rpx" color="#0066cc" />
      </view>
    </view>
  </view>

  <!-- 未加入团队状态 -->
  <view wx:else class="empty_section">
    <view class="empty_icon_wrap">
      <image class="empty_icon" src="../../static/icon/my_device_bg.png" mode="aspectFit" />
    </view>
    <text class="empty_text">{{userInfo ? '暂无归属团队' : '暂未登录'}}</text>
    <view class="empty_btn" wx:if="{{userInfo}}" bindtap="goSearchTeam">加入团队</view>
    <view class="empty_btn" wx:else bindtap="goLoginFlag">立即登录</view>
  </view>
</view>
<t-dialog visible="{{isLogin}}" title="温馨提示" content="您尚未登录，请先登录！">
  <t-button slot="confirm-btn" class="action-btn" theme="primary" bindtap="goLogin">去登录</t-button>
  <t-button slot="cancel-btn" class="cancel-btn" theme="primary" bindtap="closeIsLoginDialog">
    取消
  </t-button>
</t-dialog>
<t-message id="t-message" />
<t-dialog visible="{{qrCodeBox}}" bind:close="closeDialog" close-on-overlay-click="{{true}}">
  <!-- 适配skyline，增加type="list" -->
  <view slot="content" class="dialog_content">
    <t-loading wx:if="{{!qrFlag}}" theme="circular" size="40rpx" text="正在加载中..." class="wrapper" />
    <view style="display: {{qrFlag ? '' : 'none'}};">
      <t-cell t-class="qr_userInfo" title="{{userInfo.userName}}" bordered="{{false}}">
        <t-avatar slot="left-icon" size="medium" image="{{ossUrl + userInfo.avatar}}"></t-avatar>
        <!-- <image slot="description" class="tag_icon" src="../../static/icon/admin.png" /> -->
        <view class="tag_box" slot="description">
          <image class="tag_icon" src="../../static/icon/admin.png" />
          <text class="tag_text">{{userInfo.roles[0].roleName}}</text>
        </view>
      </t-cell>
      <view class="institution_box">
        <text class="institution">所属机构：{{userInfo.dept.deptName}}</text>
      </view>
      <view class="qr_image_box">
        <canvas class="qr_image" canvas-id="myQrcode"></canvas>
      </view>
      <view class="qr_code_text">扫一扫，快速加入我们的团队</view>
    </view>
  </view>
  <button style="display: {{qrFlag ? '' : 'none'}};" slot="confirm-btn" class="save_invite" bindtap="saveQrCode">
    保存邀请码
  </button>
</t-dialog>