<view class="device-use_container">
  <t-navbar t-class="navBar" fixed="{{false}}" left-arrow>
    <view slot="title" class="navBar_title">
      <view class="green"></view>
      <view>设备未绑定</view>
    </view>
  </t-navbar>
  <view class="content">
    <view class="title">选择要绑定的机构</view>
    <view class="search_box">
      <t-input t-class="item-input" prefixIcon="search" placeholder="请输入文字" borderless bind:change="searchChange"></t-input>
      <view class="extra">取消</view>
    </view>
    <view class="scroll_title">我的团队</view>
    <scroll-view class="scroll-view" scroll-y="true" scroll-with-animation="true" bindscrolltolower="onScrollToLower">
      <t-radio-group borderless t-class="box" bind:change="bindChange">
        <t-cell wx:for="{{displayList}}" wx:key="{{item.deptId}}" t-class="list_item" bordered="{{false}}">
          <t-avatar slot="left-icon" size="large" image="{{ossUrl + item.deptAvatar}}"></t-avatar>
          <view slot="title" class="title_box">
            <text class="title_text">{{item.deptName}}</text>
          </view>
          <view slot="description">
            <view class="description_text">所属机构：{{item.parentName}}</view>
            <view class="description_text">{{item.address}}</view>
          </view>
          <view slot="right-icon" class="right-icon">
            <t-radio block="{{false}}" value="{{item.deptId}}" />
          </view>
        </t-cell>
      </t-radio-group>
      <!-- 底部加载状态 -->
      <view wx:if="{{loadingMore}}" style="text-align:center;padding:30rpx 0;color:#999;font-size:24rpx;">加载中...</view>
      <view wx:elif="{{!hasMore && displayList.length > 0}}" style="text-align:center;padding:30rpx 0;color:#999;font-size:24rpx;">没有更多了</view>
      <view wx:elif="{{displayList.length < 1}}" style="margin-top: 40rpx">
        <t-empty t-class="empty" t-class-image="empty_image" image="/static/icon/footer.png" description="糟糕，到底了" />
      </view>
    </scroll-view>
  </view>
  <view class="footer">
    <view class="no_bind" bindtap="noBind">暂不绑定</view>
    <button class="save_btn" bindtap="onSubmit">绑定设备</button>
  </view>
</view>
<t-message id="t-message" />