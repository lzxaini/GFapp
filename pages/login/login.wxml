<view class="login_container">
  <!-- <view class="logo_bg">
    <t-image class="image_bg" src="/static/icon/login.png" />
  </view> -->
  <view class="login_body">
    <view class="logo_gf" style="padding-top: {{statusBarHeight}}px">
      <t-image class="logo_gf_img" src="/static/icon/logo.png" />
    </view>
    <view class="welcome">
      <view class="title">欢迎登录</view>
      <view class="subtitle">使用您的账号开始今日美肤之旅</view>
    </view>
    <view class="login_from">
      <view class="item">
        <t-input t-class="item-input" t-class-tips="errMsg" slot="note" placeholder="请输入手机号码" value="{{from.phoneNumber}}" type="text" tips="{{phoneNumberError}}" bindchange="onInput" bindblur="verify" confirm-type="next" borderless data-type="phoneNumber">
          <t-icon slot="prefix-icon" name="mobile" size="40rpx" color="#9A95AA" />
        </t-input>
      </view>
      <view class="item">
        <t-input t-class="item-input" t-class-tips="errMsg" slot="note" placeholder="请输入账号密码" value="{{from.password}}" type="{{passwordFlag ? 'text' : 'password'}}" tips="{{passwordError}}" bindchange="onInput" bindblur="verify" data-type="password" confirm-type="next" borderless>
          <t-icon slot="prefix-icon" name="user-safety" size="40rpx" color="#9A95AA" />
          <t-icon slot="suffix" name="{{passwordFlag ? 'browse' : 'browse-off'}}" size="40rpx" data-type="password" data-flag="{{passwordFlag}}" bind:click="passwordFlag" color="#9A95AA" />
        </t-input>
      </view>
      <button class="login_btn" bindtap="onSubmit">登 录</button>
    </view>
    <view class="other_login">
      <t-divider content="其他登录方式" />
      <!-- <t-grid t-class="grid" column="{{2}}">
      <t-grid-item t-class-text="text" t-class-image="image" text="一键登录" icon="star" />
      <t-grid-item t-class-text="text" t-class-image="image" text="随便看看" icon="star" />
    </t-grid> -->
      <t-button icon="chat-bubble" wx:if="{{!checkFlag}}" class="login_btn" bindtap="login">
        手机号一键登录
      </t-button>
      <t-button icon="chat-bubble" wx:else class="login_btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
        手机号一键登录
      </t-button>
    </view>
    <view class="agreement">
      <t-checkbox value="{{checkFlag}}" t-class="check" bindchange="agreementChange" />
      <view class="agreement_info">
        我已阅读并同意
        <text class="info" bindtap="goPrivacyAgreement">《用户协议》</text>
        和
        <text class="info" bindtap="goPrivacyAgreement">《隐私政策》</text>
      </view>
    </view>
    <view class="go_index" bindtap="goIndex">
      <t-icon name="home" size="22" t-class="icon-color"></t-icon>
      <view class="text">首页</view>
    </view>
  </view>
</view>
<t-dialog visible="{{showConfirm}}" title="温馨提示" content="请您仔细阅读并充分理解相关条款，点击同意即代表您已阅读并同意">
  <t-button slot="confirm-btn" class="action-btn" theme="primary" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
    同意协议
  </t-button>
  <t-button slot="cancel-btn" class="cancel-btn" theme="primary" bindtap="closeDialog">取消</t-button>
</t-dialog>
<t-message id="t-message" />